    given-names: Bart
    orcid: "https://orcid.org/0000-0002-8788-7980"
repository-code: "https://gitlab.com/bart-turczynski/rurl"
repository: "https://CRAN.R-project.org/package=rurl"
url: "https://gitlab.com/bart-turczynski/rurl"
license: MIT
identifiers:
  - type: doi
    value: 10.5281/zenodo.20972584
    description: >-
      Concept DOI (all deposited versions). Deposits were minted by Zenodo's
      GitHub integration, which is gone, so the chain stops at 1.4.0 and this
      resolves there rather than to the current release.
  - type: doi
    value: 10.5281/zenodo.20972585
    description: "Version DOI for rurl 1.4.0. Later releases have none."
keywords:
  - URL parsing
  - URL normalization
  - URL cleaning
  - domain extraction
  - public suffix
  - TLD extraction
  - IDNA
  - Punycode

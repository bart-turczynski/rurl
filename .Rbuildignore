# The citation gate ported from seor (design/adr/0002 there). Not part
# of the installable package; without this, --as-cran reports it as a
# non-standard top-level directory.
^scripts$
# The deep-check CI library. The .rocker template points R_LIBS_USER here
# and caches it, so R CMD build packed every installed dependency into the
# tarball and --as-cran failed on their executables: deep-check pipeline
# 2909433500, SEOR-nxycpzlk. punycoder carries the same entry. Keep these
# lines free of unbalanced brackets: R 4.1 reads comment lines as patterns.
^\.Rlibs$
# The same for fleet-ci's t2-sanitizers job, which installs the dependencies
# into $CI_PROJECT_DIR/.fleet-lib and then runs `R CMD build .` there.
^\.fleet-lib$
# The fleet-ci local gate: the vendored runner and its settings, per
# fleet-ci's README, "Adopting the template", and the locale cheap gate it
# runs. Every line here is a regular expression, comments included: no
# unbalanced brackets.
^\.fleet-ci$
^\.fleet-ci\.yml$
^tools/check-locale-tests\.R$

#!/usr/bin/env python3
"""bin/pre-push: a fleet package's git pre-push hook, vendored as .fleet-ci/pre-push.

    .fleet-ci/pre-push REMOTE [URL]    as git's pre-push hook (refs on stdin)
    .fleet-ci/pre-push --install       install this as the repository's hook
    .fleet-ci/pre-push --check-installed [URL]
                                       exit 0 when it is installed

git hands a pre-push hook every pushed ref on stdin. pre-commit's own hook
runs each pre-push hook once per ref with PRE_COMMIT_TO_REF set, and none of
them sees the whole push, so `.fleet-ci/gate auto` inside pre-commit gates
only that one ref and cannot refuse a push of several refs to main or of
more than one merge. This hook reads stdin once and:

  1. runs `.fleet-ci/gate pre-push REMOTE URL` with it: every pushed sha is
     gated, and the push-shape refusals run;
  2. when the gate passes and the repository has a .pre-commit-config.yaml,
     runs pre-commit's pre-push stage with the same arguments and stdin, as
     pre-commit's own hook would (`pre-commit hook-impl --hook-type=pre-push`),
     so the package's other pre-push hooks still run. That configuration
     must not run the gate itself.

Under pre-commit's migration mode (`pre-commit install -t pre-push` run over
this hook moves it to pre-push.legacy, and pre-commit's hook runs it with
PRE_COMMIT_RUNNING_LEGACY=1 before its own hooks), step 2 is pre-commit's:
this hook gates the push and exits with the gate's status, without invoking
pre-commit. `pre-commit install -f` deletes pre-push.legacy, and the gate
with it.

`--install` writes a two-line hook into the repository's hooks directory
that runs the checkout's own .fleet-ci/pre-push. It replaces pre-commit's
generated pre-push hook (this one runs that stage) and a fleet-ci shim,
removes a pre-push.legacy that is a fleet-ci shim, and refuses any other
existing hook or pre-push.legacy, a dangling symlink included. A fleet-ci
shim is a marker line starting with STEM (the current MARK or an older
one), one `exec` of .fleet-ci/pre-push, and nothing but the shebang and
comments besides; pre-commit's hook is the one carrying its "File generated
by pre-commit" header and its `hook-impl` call. Exit 0 when the push may go
on, non-zero otherwise.

`--check-installed` is for a package's pre-commit guard. By the same
classifier `--install` uses, it exits 0 when this checkout's hook is
fleet-ci's: an executable hooks/pre-push that is a fleet-ci shim, or
pre-commit's executable generated hook with an executable pre-push.legacy
that is one (migration mode). An older shim passes with a one-line note
that `--install` replaces it. Otherwise it says which state it found and
either that `--install` fixes it or, where `--install` would refuse, what
to move away first, and exits 1 (2 outside a git repository). A local URL
(below), given as URL or, without one, in PRE_COMMIT_REMOTE_URL, passes
unchecked, as the hook would let that push through.

A push to a local URL (git's own rule: a path with no `:` before its first
`/`, or file:/// with an empty host; such as a package's archival `backup`
mirror, which only receives history already on origin) is not gated: the
hook says so in one line and exits 0, running neither the gate nor
pre-commit's stage (under migration mode, pre-commit's own pre-push hooks
still run after it). Any URL with a host (ssh://, https://, file://host/,
host:path, git@host:path) is gated.
"""

import os
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
MARK = "# fleet-ci pre-push hook (.fleet-ci/pre-push --install)"
HOOK = "#!/bin/sh\n%s\nexec .fleet-ci/pre-push \"$@\"\n" % MARK
# MARK has had one value so far. STEM is forward compatibility: any later
# MARK must start with it, so a shim an older fleet-ci wrote is still
# recognised after MARK changes. Keep MARK on one `MARK = "..."` line:
# packages' guards read it.
STEM = "# fleet-ci pre-push hook"
PRE_COMMIT_HEADER = "# File generated by pre-commit: https://pre-commit.com"


def say(msg):
    print("fleet-ci pre-push: %s" % msg, file=sys.stderr, flush=True)


def git_out(*args):
    res = subprocess.run(["git"] + list(args), capture_output=True, text=True, check=False)
    return res.stdout.strip() if res.returncode == 0 else None


def is_local_mirror(url):
    """bin/gate's is_local_mirror(), repeated rather than imported, so the hook
    decides before it starts the gate at all. tests/gate_test.py runs both
    over one table."""
    if not url:
        return False
    if "://" in url:
        return url.startswith("file:///")
    colon, slash = url.find(":"), url.find("/")
    return colon < 0 or 0 <= slash < colon


def is_fleet_hook(text):
    """True for a shim any fleet-ci wrote: a marker line starting with STEM
    (the current MARK or an older one), an `exec` of .fleet-ci/pre-push, and
    nothing else but the shebang and comments."""
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    execs = [l for l in lines if l.startswith("exec ") and ".fleet-ci/pre-push" in l]
    return (any(l.startswith(STEM) for l in lines) and len(execs) == 1
            and all(l.startswith("#") or l in execs for l in lines))


def is_pre_commit_hook(text):
    """True for the hook `pre-commit install` generates: its header line and
    its `hook-impl` call. Merely mentioning pre-commit is not enough."""
    lines = [l.strip() for l in text.splitlines()]
    return PRE_COMMIT_HEADER in lines and "hook-impl" in text


def classify(path):
    """(kind, executable) for a hook file, the one rule --install and
    --check-installed share. kind: missing, broken (a dangling symlink, a
    directory, unreadable), fleet (the current shim), fleet-old (an older
    fleet-ci shim), pre-commit, or foreign."""
    if not os.path.lexists(path):
        return "missing", False
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        return "broken", False
    executable = os.access(path, os.X_OK)
    if is_fleet_hook(text):
        return ("fleet" if MARK in [l.strip() for l in text.splitlines()] else "fleet-old"), executable
    if is_pre_commit_hook(text):
        return "pre-commit", executable
    return "foreign", executable


FLEET = ("fleet", "fleet-old")


def install_blocker(path, legacy):
    """Why --install would refuse this hooks directory, or None."""
    kind = classify(path)[0]
    if kind == "broken":
        return "%s is not a readable file (a dangling symlink?); move it away first" % path
    if kind == "foreign":
        return "%s exists and is neither pre-commit's nor this one; move it away first" % path
    # pre-commit's migration mode keeps the hook it replaced here, and its
    # hook-impl (which this hook runs) would run it.
    if classify(legacy)[0] not in FLEET + ("missing",):
        return ("%s exists and is not this hook; pre-commit's hook would run it too, "
                "so move it away first" % legacy)
    return None


def install():
    hooks = git_out("rev-parse", "--git-path", "hooks")
    if hooks is None:
        say("not in a git repository")
        return 2
    os.makedirs(hooks, exist_ok=True)
    path = os.path.join(hooks, "pre-push")
    legacy = path + ".legacy"
    blocker = install_blocker(path, legacy)
    if blocker:
        say(blocker)
        return 1
    if os.path.lexists(legacy):
        os.remove(legacy)
        say("removed %s (this hook, under pre-commit's migration mode)" % legacy)
    tmp = path + ".fleet-ci.tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(HOOK)
    os.chmod(tmp, 0o755)
    os.replace(tmp, path)
    say("installed %s" % path)
    return 0


def check_installed(url):
    if is_local_mirror(url):
        return 0
    hooks = git_out("rev-parse", "--git-path", "hooks")
    if hooks is None:
        say("not in a git repository")
        return 2
    path = os.path.join(hooks, "pre-push")
    legacy = path + ".legacy"
    kind, executable = classify(path)
    found = None
    if kind in FLEET and executable:
        found = (path, kind)
    elif kind == "pre-commit" and executable:
        # Migration mode: pre-commit's hook runs pre-push.legacy first.
        lkind, lexec = classify(legacy)
        if lkind in FLEET and lexec:
            found = (legacy, lkind)
    if found is not None:
        if found[1] == "fleet-old":
            say("%s is an older fleet-ci shim; `.fleet-ci/pre-push --install` "
                "replaces it with the current one" % found[0])
        return 0
    if kind == "missing":
        why = "%s is missing" % path
    elif kind == "broken":
        why = "%s is not a readable file" % path
    elif kind == "foreign":
        why = "%s is neither pre-commit's nor fleet-ci's" % path
    elif not executable:
        why = "%s is %s but not executable" % (path, "pre-commit's" if kind == "pre-commit" else "fleet-ci's")
    else:
        why = "%s is pre-commit's, and %s is not an executable fleet-ci shim" % (path, legacy)
    blocker = install_blocker(path, legacy)
    fix = ("Install it once, from the package root: .fleet-ci/pre-push --install" if blocker is None
           else "--install would refuse: %s, then run .fleet-ci/pre-push --install" % blocker)
    say("push refused: this clone's pre-push hook is not fleet-ci's (%s), so the push "
        "would not run the gate. %s" % (why, fix))
    return 1


def main(argv):
    if argv == ["--install"]:
        return install()
    if argv[:1] == ["--check-installed"] and len(argv) <= 2:
        url = argv[1] if len(argv) == 2 else os.environ.get("PRE_COMMIT_REMOTE_URL", "")
        return check_installed(url)
    if len(argv) not in (1, 2) or argv[0].startswith("-"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    lines = sys.stdin.buffer.read()
    if len(argv) == 2 and is_local_mirror(argv[1]):
        print("gate: skipped, %s is a local mirror (%s)" % (argv[0], argv[1]), file=sys.stderr, flush=True)
        return 0
    gate = os.path.join(HERE, "gate")
    code = subprocess.run([gate, "pre-push"] + argv, input=lines, check=False).returncode
    if code != 0:
        say("the gate refused the push (exit %d)" % code)
        return code
    if os.environ.get("PRE_COMMIT_RUNNING_LEGACY"):
        # pre-commit's hook ran this one as pre-push.legacy and runs its own
        # hooks next; calling hook-impl from here would abort ("installed in
        # migration mode").
        return code
    top = git_out("rev-parse", "--show-toplevel") or os.getcwd()
    config = os.path.join(top, ".pre-commit-config.yaml")
    if not os.path.isfile(config):
        return 0
    if shutil.which("pre-commit") is None:
        say("%s exists but pre-commit is not on PATH, so its pre-push hooks cannot run" % config)
        return 1
    hooks = git_out("rev-parse", "--git-path", "hooks") or os.path.join(top, ".git", "hooks")
    cmd = ["pre-commit", "hook-impl", "--config=%s" % config, "--hook-type=pre-push",
           "--hook-dir", os.path.abspath(hooks), "--"] + argv
    code = subprocess.run(cmd, input=lines, cwd=top, check=False).returncode
    if code != 0:
        say("pre-commit's pre-push stage failed (exit %d)" % code)
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
